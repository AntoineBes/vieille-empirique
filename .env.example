# PostgreSQL Neon
# Récupérer depuis dashboard.neon.tech → votre projet → Connection Details
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# API PISTE (Légifrance) — optionnel, nécessaire uniquement pour le connecteur Légifrance
# Inscription : https://developer.aife.economie.gouv.fr/
PISTE_CLIENT_ID="votre_client_id"
PISTE_CLIENT_SECRET="votre_client_secret"

# Judilibre (Cour de cassation) — optionnel, nécessaire pour le connecteur Judilibre
# Inscription gratuite : https://developer.aife.economie.gouv.fr/
JUDILIBRE_API_KEY="votre_api_key"

# Note : les APIs INSEE BDM, Eurostat, OCDE et le RSS Sénat sont en accès libre.
